# Anthropic API key for the chatbot (copy this file to .env and fill it in).
ANTHROPIC_API_KEY=
# Optional: override the chat model (defaults to claude-haiku-5-5).
# CHAT_MODEL=

# Supabase (accounts + class booking). Project Settings -> API.
# The anon/publishable key is safe in the browser; row-level security guards the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
